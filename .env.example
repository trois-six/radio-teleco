# Copy to .env (git-ignored) and fill in, then: uv run --env-file .env radio-teleco ...

# Seed constant of the rolling code (24 bits, e.g. 0x123456). Never commit it: it may
# depend on your box's block of transmitter serials. Recover it from one frame of a
# transmitter whose serial you know: radio-teleco calibrate <serial> "<frame>"
RADIO_TELECO_SEED_XOR=

# Box access, as for aioteleco's `teleco` command
TELECO_EMAIL=
TELECO_PASSWORD=
TELECO_LOCAL_IP=
